{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kriya.local/schemas/rights.schema.json",
  "title": "KRIYA Rights Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspaceId", "subjectType", "authorizationStatus", "permittedUses", "evidenceReference", "verifiedBy", "createdAt", "expiresAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 }, "workspaceId": { "type": "string", "minLength": 1 },
    "subjectType": { "enum": ["person", "character", "music", "footage", "other"] },
    "authorizationStatus": { "enum": ["unknown", "pending-review", "authorized", "revoked", "expired"] },
    "permittedUses": { "type": "array", "uniqueItems": true, "items": { "enum": ["editing", "commercial", "training", "synthetic-likeness", "adult-content", "distribution"] } },
    "evidenceReference": { "type": ["string", "null"], "description": "Opaque reference to securely retained rights evidence; not the evidence itself." },
    "verifiedBy": { "type": ["string", "null"] }, "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [{ "if": { "properties": { "authorizationStatus": { "const": "authorized" } }, "required": ["authorizationStatus"] }, "then": { "properties": { "evidenceReference": { "type": "string", "minLength": 1 }, "verifiedBy": { "type": "string", "minLength": 1 } } } }]
}
