# Public frontend configuration (optional; omit both for local-only editing).
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CONVEX_URL=
# Written by `bunx convex dev`; identifies your development deployment.
CONVEX_DEPLOYMENT=
# Set CLERK_JWT_ISSUER_DOMAIN on the Convex deployment, not in the Vite bundle.
# Convex-only environment names (set in Convex dashboard, never VITE_):
# GROQ_API_KEY: owner-supplied Groq Free-plan key
# GROQ_FREE_PLAN_CONFIRMED=true
# AGENT_ALLOWED_SUBJECTS: comma-separated allowed Clerk user IDs
# SUPERMEMORY_API_KEY: optional server-only semantic recall
# KRIYA_ENABLE_PAID_PROVIDERS=true: explicit paid-provider kill switch
# OPENAI_API_KEY + OPENAI_MODEL
# ANTHROPIC_API_KEY + ANTHROPIC_MODEL
# GEMINI_API_KEY + GEMINI_MODEL
# XAI_API_KEY + XAI_MODEL
